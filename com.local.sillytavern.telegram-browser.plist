<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.sillytavern.telegram-browser</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__HOME__/Library/Application Support/SillyTavernTelegramBridge/browser-keeper.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/Library/Application Support/SillyTavernTelegramBridge</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/SillyTavernTelegramBrowser.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/SillyTavernTelegramBrowser.error.log</string>
</dict>
</plist>
